UPD = {"at": 0, "data": None}
UPD_LOCK = threading.Lock()
PLUGINS_HOME = os.path.expanduser("~/.config/omarchy/plugins")
CATALOG_CHECK = {"at": 0}


def maybe_check_self_update():
    """Let 'Check now' also notice a newer Omarchy Store itself, instead of waiting for the
    hourly background check. Throttled so repeated clicks don't hammer the network."""
    if time.time() - CATALOG_CHECK["at"] < 120:
        return
    CATALOG_CHECK["at"] = time.time()
    try:
        update_catalog(quiet=True)
    except Exception:
        pass


def _vercmp(a, b):
    """Compare two version strings. Prefers Arch's own `vercmp` (handles epoch/pkgrel exactly),
    but NEVER silently reports "equal" if that fails — a missing/broken `vercmp` must not be able
    to make a real update invisible. Falls back to a plain numeric/alpha segment compare."""
    try:
        out = subprocess.run(["vercmp", a, b], capture_output=True, text=True, timeout=5).stdout.strip()
        if out.lstrip("-").isdigit():
            return int(out)
    except Exception:
        pass
    try:
        key = lambda v: [int(p) if p.isdigit() else p for p in re.split(r"(\d+)", v) if p != ""]
        ka, kb = key(a), key(b)
        for x, y in zip(ka, kb):
            if type(x) != type(y):
                x, y = str(x), str(y)
            if x != y:
                return 1 if x > y else -1
        return (len(ka) > len(kb)) - (len(ka) < len(kb))
    except Exception:
        return 0


def check_updates(force=False):
    """Which store apps (and how many system packages) have updates. Read-only, no password needed."""
    with UPD_LOCK:
        if not force and UPD["data"] and time.time() - UPD["at"] < 600:
            return UPD["data"]
    cat = load_catalog()
    have = {}
    try:
        for ln in subprocess.run(["pacman", "-Q"], capture_output=True, text=True, timeout=20).stdout.splitlines():
            n, v = ln.split()[:2]; have[n] = v
    except Exception:
        pass
    repo, aur = {}, {}
    # checkupdates syncs a private copy of the package database, so it never touches the system.
    try:
        out = subprocess.run(["checkupdates", "--nocolor"], capture_output=True, text=True, timeout=120).stdout
        for ln in out.splitlines():
            p = ln.split()
            if len(p) >= 4: repo[p[0]] = p[3]
    except Exception:
        pass
    if shutil.which("yay"):
        try:
            out = subprocess.run(["yay", "-Qua"], capture_output=True, text=True, timeout=90).stdout
            for ln in out.splitlines():
                p = ln.split()
                if len(p) >= 4: aur[p[0]] = p[3]
        except Exception:
            pass
    apps = []
    used_pkgs = set()
    for aid, a in cat.items():
        det = a.get("detect") or []
        pkg = det[0] if det else None
        if pkg and pkg not in have and file_install_version(aid):
            # Set up with its own installer file: compare that copy's version with the store's.
            mine = file_install_version(aid)
            latest = (a.get("package") or {}).get("version") or (a.get("install") or {}).get("version")
            if latest and _vercmp(latest, mine) > 0:
                apps.append({"id": aid, "installed": mine, "latest": latest, "via": "release"})
            continue
        if not pkg or pkg not in have:
            continue
        m = a["install"]["method"]
        new = None
        if m == "release":
            latest = (a.get("package") or {}).get("version")
            if latest and _vercmp(latest, have[pkg].split("-")[0]) > 0:
                new = latest
        else:
            new = repo.get(pkg) or aur.get(pkg)
        if new:
            apps.append({"id": aid, "installed": have[pkg], "latest": new,
                         "via": "system" if pkg in repo else ("release" if m == "release" else "aur")})
            used_pkgs.add(pkg)
    # Plugins: the store's own (official) ones update by themselves, others get an UPDATE button.
    for pu in plugin_updates():
        with JOBS_LOCK:
            last = JOBS.get("update:" + pu["id"]) or {}
        if pu["own"] and not (last.get("state") == "failed" and time.time() - last.get("started", 0) < 3600):
            try:
                run_plugin_update(pu["id"])
            except Exception:
                pass
        apps.append(pu)
    notify_updates([a for a in apps if not a.get("own")])
    # Every individual system (pacman repo) and AUR package that isn't already shown as a
    # Store app above, named so the Updates page can list exactly what's being updated —
    # not just a bare count — before the user hits Update.
    sys_list = [{"name": n, "installed": (have.get(n) or "?").split("-")[0], "latest": v.split("-")[0]}
                for n, v in sorted(repo.items()) if n not in used_pkgs]
    aur_list = [{"name": n, "installed": (have.get(n) or "?").split("-")[0], "latest": v.split("-")[0]}
                for n, v in sorted(aur.items()) if n not in used_pkgs]
    data = {"apps": apps, "system": len(sys_list), "aur": len(aur_list),
            "sys_list": sys_list, "aur_list": aur_list, "checked": time.time()}
    with UPD_LOCK:
        UPD.update(at=time.time(), data=data)
    return data


def quick_updatable(cat, inst):
    """Store-release apps on this computer with a newer version in the catalog (fast: no network),
    so their page can say UPDATE right away. Other updates show in the Updates tab."""
    out = []
    have = {}
    try:
        for ln in subprocess.run(["pacman", "-Q"], capture_output=True, text=True, timeout=15).stdout.splitlines():
            n, v = ln.split()[:2]; have[n] = v.split("-")[0]
    except Exception:
        pass
    for aid in inst:
        a = cat.get(aid) or {}
        if (a.get("install") or {}).get("method") != "release":
            continue
        det = a.get("detect") or []
        mine = have.get(det[0]) if det else None
        mine = mine or file_install_version(aid)
        latest = (a.get("package") or {}).get("version") or a["install"].get("version")
        if mine and latest and _vercmp(latest, mine) > 0:
            out.append(aid)
    return out


def run_update(app=None):
    """Update one app, or everything (Omarchy's own updater) when app is None."""
    if app is None:
        cmd = "omarchy-update" if shutil.which("omarchy-update") else "yay -Syu"
        script = f"echo 'Updating Omarchy, system packages and AUR apps…'; echo; {cmd}"
        key = "__all__"
    else:
        m = app["install"]["method"]
        pkgs = app["install"].get("packages") or []
        if not all(PKG_RE.match(p) for p in pkgs):
            raise ValueError("bad package list")
        if m == "release":
            argv = ["sudo", "pacman", "-U", "--needed", fetch_release(app)]
        elif m == "aur":
            argv = ["yay", "-S", "--needed", "--noconfirm"] + pkgs
        else:
            # Arch never updates one repo package on its own (partial upgrades break systems).
            return run_update(None)
        script = f"echo {shlex.quote('Updating ' + app['name'] + '…')}; echo; " + " ".join(shlex.quote(x) for x in argv)
        key = app["id"]
    with JOBS_LOCK:
        JOBS["update:" + key] = {"state": "running", "started": time.time()}
    proc = in_terminal(script, "Update")

    def watch():
        proc.wait()
        # The terminal is detached; re-check for a while and mark done once the update shows up.
        for _ in range(240):
            time.sleep(5)
            d = check_updates(force=True)
            still = d["system"] + d["aur"] if key == "__all__" else any(x["id"] == key for x in d["apps"])
            if not still:
                break
        with JOBS_LOCK:
            JOBS["update:" + key]["state"] = "done"
    threading.Thread(target=watch, daemon=True).start()


# ---------------------------------------------------------------- USB maker ----
# Makes an Omarchy installer USB stick: downloads the newest official ISO from iso.omarchy.org,
# checks it against Omarchy's published SHA-256, then writes it to a USB stick the user picks.
# Safety: only removable USB drives (<= 256 GB, nothing mounted as a system folder) are ever offered,
# the drive is re-checked right before writing, and the write runs in a visible terminal that asks
# for the user's own password.
ISO_DIR = os.path.expanduser("~/Downloads")
ISO_RE = re.compile(r"https://iso\.omarchy\.org/(omarchy-(\d+(?:\.\d+)*(?:-\d+)?)\.iso)")
DEV_RE = re.compile(r"^/dev/sd[a-z]{1,2}$")
USB = {"iso": None, "iso_at": 0, "dl": {"state": "idle"}}
USB_LOCK = threading.Lock()


def _ver_key(v):
    return tuple(int(x) for x in re.split(r"[.-]", v))


def latest_iso():
    """Newest Omarchy ISO announced on omarchy.org (cached for an hour)."""
    with USB_LOCK:
        if USB["iso"] and time.time() - USB["iso_at"] < 3600:
            return USB["iso"]
    best = None
    try:
        found = {}
        for src in ("https://api.github.com/repos/omacom/omarchy/releases?per_page=10", "https://omarchy.org/"):
            try:
                req = urllib.request.Request(src, headers={"User-Agent": "omarchy-store", "Accept": "application/vnd.github+json, text/html"})
                text = urllib.request.urlopen(req, timeout=20).read(5_000_000).decode("utf-8", "ignore")
                found.update({m.group(2): m.group(1) for m in ISO_RE.finditer(text)})
            except Exception:
                pass
        if found:
            v = max(found, key=_ver_key)
            fn = found[v]
            ua = {"User-Agent": "omarchy-store"}
            sha = urllib.request.urlopen(urllib.request.Request(f"https://iso.omarchy.org/{fn}.sha256", headers=ua), timeout=20).read(400).decode().split()[0].lower()
            head = urllib.request.urlopen(urllib.request.Request(f"https://iso.omarchy.org/{fn}", method="HEAD", headers=ua), timeout=20)
            best = {"version": v, "file": fn, "url": f"https://iso.omarchy.org/{fn}", "sha256": sha,
                    "size": int(head.headers.get("Content-Length") or 0)}
    except Exception:
        best = None
    if not best:
        try:
            with open(os.path.join(SITE_DIR, "catalog.json")) as f:
                best = json.load(f).get("omarchy_iso")
        except Exception:
            best = None
    if best and not (re.match(r"^[0-9a-f]{64}$", best.get("sha256", "")) and ISO_RE.fullmatch(best.get("url", ""))):
        best = None
    with USB_LOCK:
        USB.update(iso=best, iso_at=time.time() if best else 0)
    return best


def usb_drives():
    """Removable USB drives that are safe to offer. Never the system disk or internal drives."""
    try:
        out = subprocess.run(["lsblk", "-J", "-b", "-o", "NAME,PATH,SIZE,TYPE,TRAN,RM,HOTPLUG,MODEL,VENDOR,MOUNTPOINTS,LABEL"],
                             capture_output=True, text=True, timeout=10).stdout
        devs = json.loads(out)["blockdevices"]
    except Exception:
        return []
    system = {"/", "/boot", "/boot/efi", "/efi", "/home", "/usr", "/var", "/mnt/storage", "[SWAP]"}
    res = []
    for d in devs:
        if d.get("type") != "disk" or d.get("tran") != "usb" or not (d.get("rm") or d.get("hotplug")):
            continue
        if not DEV_RE.match(d.get("path") or "") or not (1_000_000_000 <= int(d.get("size") or 0) <= 256 * 10**9):
            continue
        mounts = [m for c in (d.get("children") or []) + [d] for m in (c.get("mountpoints") or []) if m]
        if any(m in system or m.startswith(("/boot", "/home", "/usr", "/var")) for m in mounts):
            continue
        name = " ".join(x for x in [(d.get("vendor") or "").strip(), (d.get("model") or "").strip()] if x) or "USB drive"
        res.append({"path": d["path"], "name": name, "size": int(d["size"]), "mounted": mounts,
                    "parts": [c["path"] for c in (d.get("children") or []) if DEV_RE.match(re.sub(r"\d+$", "", c.get("path") or ""))]})
    return res


def iso_path(iso):
    return os.path.join(ISO_DIR, iso["file"])


def iso_ready(iso):
    p = iso_path(iso)
    ok = p + ".verified"
    try:
        return os.path.getsize(p) == iso["size"] and open(ok).read().strip() == iso["sha256"]
    except OSError:
        return False


def download_iso(iso):
    """Download (resuming if possible) and verify the ISO. Progress goes to USB['dl']."""
    os.makedirs(ISO_DIR, exist_ok=True)
    dest = iso_path(iso)
    part = dest + ".part"
    with USB_LOCK:
        USB["dl"] = {"state": "downloading", "progress": 0}
    try:
        with urllib.request.urlopen(iso["url"], timeout=300) as r:
            total = int(r.headers.get("Content-Length", 0))
            with open(dest + ".part", "wb") as f:
                while True:
                    chunk = r.read(8192)
                    if not chunk:
                        break
                    f.write(chunk)
                    with USB_LOCK:
                        USB["dl"]["progress"] = int(100 * f.tell() / total) if total else 0
        os.replace(dest + ".part", dest)
        with USB_LOCK:
            USB["dl"] = {"state": "verifying", "progress": 100}
    except Exception as e:
        with USB_LOCK:
            USB["dl"] = {"state": "error", "error": str(e)}
        return
    h = hashlib.sha256()
    with open(dest, "rb") as f:
        while True:
            chunk = f.read(1 << 16)
            if not chunk:
                break
            h.update(chunk)
    if h.hexdigest() != iso["sha256"]:
        os.remove(dest)
        with USB_LOCK:
            USB["dl"] = {"state": "error", "error": "SHA-256 mismatch"}
        return
    open(dest + ".verified", "w").write(iso["sha256"])
    with USB_LOCK:
        USB["dl"] = {"state": "ready", "progress": 100}


def write_usb(iso, device):
    if not iso_ready(iso):
        raise ValueError("ISO not ready — download and verify first")
    if not DEV_RE.match(device):
        raise ValueError("bad device")
    # Safety: drive must still be a removable USB drive
    drives = usb_drives()
    if not any(d["path"] == device for d in drives):
        raise ValueError("device is not a safe removable USB drive")
    q = shlex.quote
    script = (f"echo {q('Writing Omarchy installer to ' + device + '…')}; echo; "
              f"sudo dd if={q(iso_path(iso))} of={q(device)} bs=4M status=progress conv=fsync; "
              f"sync; echo; "
              f"echo {q('Done! Your Omarchy installer USB is ready. You can unplug it now.')} || "
              f"echo {q('Writing failed — nothing was changed on your computer. Check the USB stick and try again.')}")
    with JOBS_LOCK:
        JOBS["usb"] = {"state": "running", "started": time.time(), "device": device}
    in_terminal(script, "USB")


