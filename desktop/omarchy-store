#!/usr/bin/env python3
"""omarchy-store — desktop helper for the Omarchy Store.

Serves the store UI on http://127.0.0.1:<port> and adds a tiny local API so the
GET button can really install apps. Opens the store as a window via
omarchy-launch-webapp.

Security model (read this before changing anything):
 * Binds to 127.0.0.1 only — nothing on your network can reach it.
 * The API never accepts a command. It accepts an app *id*, looks the app up in
   the catalog shipped with the store, and runs that app's install recipe.
   Recipes are validated against a strict allow-list (package names / an
   'omarchy install ...' command), so a tampered catalog can't smuggle shell.
 * Every POST needs a per-session secret token that only the store page knows
   (injected into the page served by this process), and an Origin header that
   matches this server — so other websites in your browser can't trigger
   installs (CSRF protection).
 * Installs run in a visible Omarchy floating terminal, so you see exactly what
   happens and type your own password. The helper never sees or stores it.

Usage:
  omarchy-store                 open the store (starts helper if needed)
  omarchy-store --serve         run helper in foreground (debug)
  omarchy-store --update        pull the latest catalog now
  omarchy-store --uninstall     remove the desktop app
"""
import hashlib, json, os, re, secrets, shlex, shutil, signal, socket, subprocess, sys, threading, time
import urllib.parse, urllib.request
from http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler

APP_DIR = os.path.expanduser(os.environ.get("OMARCHY_STORE_HOME", "~/.local/share/omarchy-store"))
SITE_DIR = os.path.join(APP_DIR, "site")
STATE_DIR = os.path.expanduser("~/.local/state/omarchy-store")
PORT_FILE = os.path.join(STATE_DIR, "port")
THEME = os.path.expanduser("~/.local/state/omarchy/current/theme/colors.toml")
REMOTE = os.environ.get("OMARCHY_STORE_REMOTE", "https://omarchystore.com/")
DEFAULT_PORT = 47823
UPDATE_EVERY = 3600     # check the store for new apps / a new desktop app every hour

PKG_RE = re.compile(r"^[a-z0-9@._+-]+$")
OMARCHY_RE = re.compile(r"^omarchy install [a-z0-9 '._-]+$", re.I)
CMD_RE = re.compile(r"^[A-Za-z0-9._-]+$")
# Themes: only plain github.com/<owner>/<repo> sources and safe folder names are accepted.
THEME_REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
THEME_NAME_RE = re.compile(r"^[a-z0-9_][a-z0-9._+-]*$")
USER_THEMES = os.path.expanduser("~/.config/omarchy/themes")
SYS_THEMES = os.path.join(os.environ.get("OMARCHY_PATH", "/usr/share/omarchy"), "themes")
THEME_NOW = os.path.expanduser("~/.local/state/omarchy/current/theme.name")
# Signed-off releases hosted on GitHub by approved publishers (e.g. SnapDock). The catalog pins the
# exact file and its SHA-256; the helper refuses anything that doesn't match before pacman sees it.
RELEASE_RE = re.compile(r"^https://github\.com/(nemoclawai-tech|omarchy-community)/[A-Za-z0-9_.-]+/releases/download/[A-Za-z0-9_.+-]+/[A-Za-z0-9_.+-]+\.pkg\.tar\.zst$")
SHA_RE = re.compile(r"^[0-9a-f]{64}$")
CACHE_DIR = os.path.expanduser("~/.cache/omarchy-store")
VERSION = "1.8.14"   # desktop app version; the catalog's desktop_version tells us when a newer one is out

# ------------------------------------------------------- read-only installs ----
# AppImage and pacman installs run from a folder the user can't write to. Before 1.8.8 that made
# the update check crash on its first file write (silently): those users never saw an update and
# could never install one. Now updates go to a writable overlay copy, and on start the helper
# hands over to the overlay copy whenever it is newer, whichever launcher started it.
OVERLAY = os.path.expanduser("~/.local/share/omarchy-store-overlay")


def _writable(d):
    try:
        os.makedirs(d, exist_ok=True)
        probe = os.path.join(d, ".write-test")
        open(probe, "w").close()
        os.remove(probe)
        return True
    except Exception:
        return False


def _file_version(f):
    try:
        m = re.search(r'^VERSION = "([^"]+)"', open(f, encoding="utf-8").read(), re.M)
        return m.group(1) if m else ""
    except Exception:
        return ""


def _vkey(v):
    return [int(x) if x.isdigit() else 0 for x in re.split(r"[.\-]", v or "0")]


def prepare_home():
    """Called first thing in main(). Hand over to a newer overlay helper, or move our writable
    home to the overlay when the install folder is read-only."""
    global APP_DIR, SITE_DIR
    if os.path.realpath(APP_DIR) == os.path.realpath(OVERLAY):
        return
    ov = _file_version(os.path.join(OVERLAY, "omarchy-store"))
    if ov and _vkey(ov) > _vkey(VERSION) and os.environ.get("OMARCHY_STORE_NO_HANDOFF") != "1":
        os.environ["OMARCHY_STORE_HOME"] = OVERLAY
        os.execv(sys.executable, [sys.executable, os.path.join(OVERLAY, "omarchy-store")] + sys.argv[1:])
    if _writable(SITE_DIR):
        return
    try:
        os.makedirs(OVERLAY, exist_ok=True)
        if not os.path.isdir(os.path.join(OVERLAY, "site")):
            # Copy contents only: a read-only install's permission bits would make the overlay read-only too.
            shutil.copytree(SITE_DIR, os.path.join(OVERLAY, "site"), copy_function=shutil.copyfile)
        helper_dst = os.path.join(OVERLAY, "omarchy-store")
        if _vkey(_file_version(helper_dst)) < _vkey(VERSION):
            shutil.copyfile(os.path.abspath(__file__), helper_dst)
        un_src, un_dst = os.path.join(APP_DIR, "uninstall.sh"), os.path.join(OVERLAY, "uninstall.sh")
        if os.path.exists(un_src) and not os.path.exists(un_dst):
            shutil.copyfile(un_src, un_dst)
        for root, dirs, files in os.walk(OVERLAY):
            os.chmod(root, 0o755)
            for f in files:
                p = os.path.join(root, f)
                os.chmod(p, 0o755 if f in ("omarchy-store", "uninstall.sh") and root == OVERLAY else 0o644)
        if not _writable(os.path.join(OVERLAY, "site")):
            return
        APP_DIR, SITE_DIR = OVERLAY, os.path.join(OVERLAY, "site")
        os.environ["OMARCHY_STORE_HOME"] = OVERLAY
    except Exception:
        pass

TOKEN = secrets.token_urlsafe(24)
# Write token to a file so install.sh can use it for pre-install
TOKEN_FILE = os.path.join(STATE_DIR, "token")
try:
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(TOKEN_FILE, "w") as f:
        f.write(TOKEN)
except Exception:
    pass
JOBS = {}            # app id -> {"state": running|done|failed, "started": ts}
JOBS_LOCK = threading.Lock()

# ---------------------------------------------------------- crypto wallets ----
# Wallet browser extensions (Phantom, MetaMask…). The store never downloads or installs extension files itself:
# GET opens the wallet's official Chrome Web Store page in the user's Chromium-family browser, where they press
# "Add to Chrome". Only Chrome extension ids from the catalog are ever used (32 letters a-p, nothing else).
CHROME_ID_RE = re.compile(r"^[a-p]{32}$")
CWS_URL = "https://chromewebstore.google.com/detail/"
# Profile folders of Chromium-family browsers; an installed extension has a folder named after its id.
BROWSER_DIRS = ["~/.config/chromium", "~/.config/google-chrome", "~/.config/google-chrome-beta",
                "~/.config/BraveSoftware/Brave-Browser", "~/.config/vivaldi", "~/.config/microsoft-edge",
                "~/snap/chromium/common/chromium", "~/.var/app/org.chromium.Chromium/config/chromium",
                "~/.var/app/com.google.Chrome/config/google-chrome", "~/.var/app/com.brave.Browser/config/BraveSoftware/Brave-Browser"]


def load_crypto():
    """Wallets from the catalog, keyed by store id; entries with a malformed Chrome id are dropped."""
    try:
        with open(os.path.join(SITE_DIR, "catalog.json")) as f:
            ws = (json.load(f).get("crypto") or {}).get("wallets") or []
    except Exception:
        return {}
    return {w["id"]: w for w in ws if isinstance(w, dict) and re.match(r"^[a-z0-9-]+$", str(w.get("id", "")))
            and CHROME_ID_RE.match(str(w.get("chrome_store_id", "")))}


def installed_extensions():
    """Every Chrome extension id found in any profile of any Chromium-family browser."""
    found = set()
    for base in BROWSER_DIRS:
        base = os.path.expanduser(base)
        try:
            profiles = os.listdir(base)
        except OSError:
            continue
        for prof in profiles:
            if prof != "Default" and not prof.startswith("Profile "):
                continue
            try:
                found.update(x for x in os.listdir(os.path.join(base, prof, "Extensions")) if CHROME_ID_RE.match(x))
            except OSError:
                pass
    return found


def installed_crypto():
    have = installed_extensions()
    return sorted(i for i, w in load_crypto().items() if w["chrome_store_id"] in have)


CHROMIUM_LIKE = re.compile(r"chrom|brave|vivaldi|edge|opera", re.I)


def browser_cmd(url):
    """Command that opens url in a Chromium-family browser (extensions from the Chrome Web Store only install there).
    Omarchy's default browser is Chromium: use omarchy-launch-browser when the default is Chromium-like,
    otherwise launch an installed Chromium/Chrome/Brave directly, and as a last resort xdg-open."""
    try:
        default = subprocess.run(["xdg-settings", "get", "default-web-browser"], capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        default = ""
    if CHROMIUM_LIKE.search(default):
        if shutil.which("omarchy-launch-browser"):
            return ["omarchy-launch-browser", url]
        return ["xdg-open", url]
    for b in ("chromium", "google-chrome-stable", "google-chrome", "brave", "brave-browser", "vivaldi-stable", "microsoft-edge-stable"):
        if shutil.which(b):
            return [b, url]
    return ["xdg-open", url]


def run_crypto_install(w):
    cid = str(w.get("chrome_store_id", ""))
    if not CHROME_ID_RE.match(cid):
        raise ValueError("bad extension id")
    cmd = browser_cmd(CWS_URL + cid)
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return cmd[0]


# ---------------------------------------------------------------- catalog ----
def load_catalog():
    with open(os.path.join(SITE_DIR, "catalog.json")) as f:
        cat = json.load(f)
    out = {a["id"]: a for a in cat["apps"]}
    # The store's own listing lives under its own key; it must count as installed/removable (that's us).
    sa = cat.get("store_app")
    if isinstance(sa, dict) and sa.get("id"):
        out.setdefault(sa["id"], sa)
    return out


def load_themes():
    with open(os.path.join(SITE_DIR, "catalog.json")) as f:
        return {t["id"]: t for t in json.load(f).get("themes", [])}


def theme_folder(t):
    """Folder name the theme has in Omarchy (validated)."""
    name = t.get("install_name") or ""
    if not THEME_NAME_RE.match(name) or ".." in name:
        raise ValueError("bad theme name")
    return name


def installed_themes():
    out = set()
    for d in (USER_THEMES, SYS_THEMES):
        try:
            out.update(n for n in os.listdir(d) if os.path.isdir(os.path.join(d, n)))
        except OSError:
            pass
    return sorted(out)


def current_theme():
    try:
        return open(THEME_NOW).read().strip()
    except OSError:
        return ""


def run_theme_install(t):
    name = theme_folder(t)
    if t.get("builtin"):
        return run_theme_use(t)
    repo = t.get("repo") or ""
    if not THEME_REPO_RE.match(repo) or ".." in repo:
        raise ValueError("bad theme repo")
    url = f"https://github.com/{repo}"
    # Visible terminal so the user sees the download; no password is needed for themes.
    script = (f"echo {shlex.quote('Installing the ' + t['name'] + ' theme from the Omarchy Store…')}; echo; "
              f"omarchy-theme-install {shlex.quote(url)}")
    if shutil.which("omarchy-launch-floating-terminal-with-presentation"):
        launcher = ["omarchy-launch-floating-terminal-with-presentation", script]
    else:
        launcher = ["xdg-terminal-exec", "bash", "-c", script + "; read -n1 -p 'Press any key to close'"]
    subprocess.Popen(launcher, stdin=subprocess.DEVNULL, start_new_session=True)


def run_theme_use(t):
    name = theme_folder(t)
    if name not in installed_themes():
        raise ValueError("theme is not installed")
    subprocess.Popen(["omarchy-theme-set", name], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


# ---------------------------------------------------------------- plugins ----
# Omarchy shell plugins, listed live from the official Omarchy Plugin Marketplace.
PLUGINS_LIVE = "https://raw.githubusercontent.com/omarchy-community/store/data/plugins.json"
PLUGIN_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,120}$")
PLUGIN_REPO_RE = re.compile(r"^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
PLUGINS = {"data": None, "raw": None, "at": 0}
PLUGINS_LOCK = threading.Lock()


def plugins_data(max_age=1800):
    """Marketplace plugin list: live copy (refreshed every 30 min), cached on disk for offline use."""
    with PLUGINS_LOCK:
        if PLUGINS["data"] and time.time() - PLUGINS["at"] < max_age:
            return PLUGINS["data"], PLUGINS["raw"]
        cache = os.path.join(SITE_DIR, "plugins.json")
        raw = None
        for url in (PLUGINS_LIVE, REMOTE + "plugins.json"):
            try:
                with urllib.request.urlopen(url, timeout=20) as r:
                    raw = r.read(20_000_000)
                d = json.loads(raw)
                assert isinstance(d.get("plugins"), list) and d["plugins"]
                tmp = cache + ".tmp"
                open(tmp, "wb").write(raw)
                os.replace(tmp, cache)
                break
            except Exception:
                raw = None
        if raw is None:
            try:
                raw = open(cache, "rb").read()
            except OSError:
                raw = b'{"plugins": [], "categories": [], "source": {}}'
        PLUGINS.update(data=json.loads(raw), raw=raw, at=time.time())
        return PLUGINS["data"], raw


def installed_plugins():
    try:
        out = subprocess.run(["omarchy", "plugin", "list", "--json"], capture_output=True, text=True, timeout=20).stdout
        return sorted(p["id"] for p in json.loads(out or "[]") if not p.get("firstParty"))
    except Exception:
        return []


def plugin_updates():
    """Installed marketplace plugins with a newer version in the store."""
    out = []
    try:
        d, _ = plugins_data()
    except Exception:
        return out
    by = {p.get("id"): p for p in d.get("plugins", [])}
    for pid in installed_plugins():
        x = by.get(pid)
        if not x or not x.get("v") or not PLUGIN_ID_RE.match(pid):
            continue
        try:
            mine = json.load(open(os.path.join(PLUGINS_HOME, pid, "manifest.json"))).get("version")
        except Exception:
            continue
        if mine and _vercmp(str(x["v"]), str(mine)) > 0:
            out.append({"id": pid, "installed": str(mine), "latest": str(x["v"]), "via": "plugin",
                        "name": x.get("n", pid), "icon": x.get("icon", ""), "own": bool(x.get("own"))})
    return out


def run_plugin_update(pid):
    """Update one plugin in the background. Plugins live in your home folder, so no password is needed."""
    if not PLUGIN_ID_RE.match(pid) or pid not in installed_plugins():
        raise ValueError("unknown plugin")
    key = "update:" + pid
    with JOBS_LOCK:
        if JOBS.get(key, {}).get("state") == "running":
            return
        JOBS[key] = {"state": "running", "started": time.time()}

    def work():
        ok = False
        try:
            ok = subprocess.run(["omarchy", "plugin", "update", pid, "--yes"], stdin=subprocess.DEVNULL,
                                capture_output=True, timeout=300).returncode == 0
        except Exception:
            pass
        with JOBS_LOCK:
            JOBS[key] = {"state": "done" if ok else "failed", "started": time.time()}
        with UPD_LOCK:
            UPD["at"] = 0          # check again next time
    threading.Thread(target=work, daemon=True).start()


def notify_updates(apps):
    """One desktop notification per new version, so updates get noticed."""
    f = os.path.join(STATE_DIR, "notified.json")
    try:
        seen = json.load(open(f))
    except Exception:
        seen = {}
    fresh = [a for a in apps if seen.get(a["id"]) != a["latest"]]
    if not fresh or not shutil.which("notify-send"):
        return
    cat = load_catalog()
    names = ", ".join(a.get("name") or (cat.get(a["id"]) or {}).get("name", a["id"]) for a in fresh)
    try:
        subprocess.Popen(["notify-send", "-a", "Omarchy Store", "-i", "system-software-update",
                          "Updates ready in the Omarchy Store", names + ". Open the store's Updates page to install."],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        for a in fresh:
            seen[a["id"]] = a["latest"]
        os.makedirs(STATE_DIR, exist_ok=True)
        json.dump(seen, open(f, "w"))
    except Exception:
        pass


def run_plugin_add(pid):
    if not PLUGIN_ID_RE.match(pid):
        raise ValueError("bad plugin id")
    d, _ = plugins_data()
    x = next((p for p in d.get("plugins", []) if p.get("id") == pid), None)
    if not x:
        raise ValueError("unknown plugin")
    repo = x.get("r") or ""
    if not x.get("i") or not PLUGIN_REPO_RE.match(repo) or ".." in repo:
        raise ValueError("this plugin needs manual setup")
    url = repo + ".git"
    head = f"Adding the {x.get('n', pid)} plugin from the Omarchy Store…"
    warn = "" if x.get("ok") else "echo 'Note: this plugin is Unverified (the marketplace has not checked its code yet).'; echo; "
    script = (f"echo {shlex.quote(head)}; echo; {warn}"
              f"omarchy plugin add {shlex.quote(url)} --enable")
    if shutil.which("omarchy-launch-floating-terminal-with-presentation"):
        launcher = ["omarchy-launch-floating-terminal-with-presentation", script]
    else:
        launcher = ["xdg-terminal-exec", "bash", "-c", script + "; read -n1 -p 'Press any key to close'"]
    subprocess.Popen(launcher, stdin=subprocess.DEVNULL, start_new_session=True)


def recipe(app):
    """Return argv that installs `app`, or raise ValueError if the recipe isn't safe."""
    inst = app.get("install") or {}
    m = inst.get("method")
    if m in ("pacman", "aur"):
        pk = inst.get("packages") or []
        if not pk or not all(PKG_RE.match(p) for p in pk):
            raise ValueError("bad package list")
        return (["omarchy-pkg-add"] if m == "pacman" else ["omarchy-pkg-aur-add"]) + pk
    if m == "omarchy":
        cmd = inst.get("command", "")
        if not OMARCHY_RE.match(cmd):
            raise ValueError("bad omarchy command")
        return shlex.split(cmd)
    if m == "release":
        if not RELEASE_RE.match(inst.get("url", "")) or not SHA_RE.match(inst.get("sha256", "")):
            raise ValueError("bad release recipe")
        pk = inst.get("packages") or []
        if not pk or not all(PKG_RE.match(p) for p in pk):
            raise ValueError("bad package list")
        return ["pacman", "-U"]   # real file path is filled in by run_install after the checksum passes
    if m == "store":
        raise ValueError("you already have Omarchy Store: it's this app. Updates appear in the bottom right corner")
    raise ValueError("unknown install method")


def fetch_release(app):
    """Download a pinned release package and verify its SHA-256. Returns the local path."""
    inst = app["install"]
    os.makedirs(CACHE_DIR, exist_ok=True)
    dest = os.path.join(CACHE_DIR, os.path.basename(inst["url"]))
    h = hashlib.sha256()
    tmp = dest + ".part"
    with urllib.request.urlopen(inst["url"], timeout=60) as r, open(tmp, "wb") as f:
        while True:
            b = r.read(1 << 16)
            if not b:
                break
            h.update(b); f.write(b)
            if f.tell() > 200_000_000:
                raise ValueError("download too large")
    if h.hexdigest() != inst["sha256"]:
        os.remove(tmp)
        raise ValueError("download failed its safety check (checksum mismatch) — not installed")
    os.replace(tmp, dest)
    return dest


# Apps that can also be set up with their own installer file instead of the store package
# (SnapDock's snapdock-install.sh). Such a copy lives in the home folder and has a VERSION file,
# so the store still sees it, offers UPDATE (which moves it to the store package), and REMOVE.
# (SnapDock 2 keeps its file-installed copy in ~/.local/share/snapdock/app; 0.x kept it one folder up.)
FILE_INSTALLS = {"snapdock": ["~/.local/share/snapdock/app/VERSION", "~/.local/share/snapdock/VERSION"]}


def file_install_version(aid):
    for f in FILE_INSTALLS.get(aid) or []:
        try:
            v = open(os.path.expanduser(f)).read().strip()
        except OSError:
            continue
        if re.match(r"^[0-9][0-9A-Za-z.+_-]{0,30}$", v):
            return v
    return None


def installed_ids(catalog):
    try:
        have = set(subprocess.run(["pacman", "-Qq"], capture_output=True, text=True, timeout=15).stdout.split())
    except Exception:
        return []
    return [i for i, a in catalog.items()
            if (a.get("install") or {}).get("method") == "store"   # the Omarchy Store listing: that's us, running now
            or (a.get("detect") and all(p in have for p in a["detect"])) or file_install_version(i)]


def read_theme():
    try:
        out = {}
        for line in open(THEME):
            m = re.match(r'\s*(\w+)\s*=\s*"(#[0-9a-fA-F]{3,8}|light|dark)"', line)
            if m:
                out[m.group(1)] = m.group(2)
        return out or None
    except OSError:
        return None


# ---------------------------------------------------------------- actions ----
def in_terminal(script, title):
    """Run a fixed, pre-quoted script in Omarchy's floating terminal (the user types their own password)."""
    if shutil.which("omarchy-launch-floating-terminal-with-presentation"):
        launcher = ["omarchy-launch-floating-terminal-with-presentation", script]
    else:
        launcher = ["xdg-terminal-exec", "bash", "-c", script + "; read -n1 -p 'Press any key to close'"]
    return subprocess.Popen(launcher, stdin=subprocess.DEVNULL, start_new_session=True)


def run_install(app):
    argv = recipe(app)
    if app["install"]["method"] == "release":
        argv = ["sudo", "pacman", "-U", "--needed", fetch_release(app)]
    name = app["name"]
    # Show the install in Omarchy's floating terminal so the user sees progress and
    # types their own sudo password. We pass a fixed, quoted command string.
    shown = " ".join(shlex.quote(a) for a in argv)
    script = f"echo {shlex.quote('Installing ' + name + ' from the Omarchy Store…')}; echo; {shown}"
    if shutil.which("omarchy-launch-floating-terminal-with-presentation"):
        launcher = ["omarchy-launch-floating-terminal-with-presentation", script]
    else:
        launcher = ["xdg-terminal-exec", "bash", "-c", script + "; read -n1 -p 'Press any key to close'"]
    with JOBS_LOCK:
        JOBS[app["id"]] = {"state": "running", "started": time.time()}
    proc = subprocess.Popen(launcher, stdin=subprocess.DEVNULL, start_new_session=True)

    def watch():
        # The launcher execs into a detached terminal, so we track completion by
        # polling pacman rather than the process.
        proc.wait()
        deadline = time.time() + 30 * 60
        while time.time() < deadline:
            time.sleep(3)
            if app["id"] in installed_ids({app["id"]: app}):
                with JOBS_LOCK:
                    JOBS[app["id"]]["state"] = "done"
                return
        with JOBS_LOCK:
            JOBS[app["id"]]["state"] = "failed"
    threading.Thread(target=watch, daemon=True).start()


# ------------------------------------------------------------- uninstall ----
# Packages Omarchy itself depends on are never offered for removal (that could break the desktop).
OMARCHY_PKG_LISTS = ("/usr/share/omarchy/install/omarchy-base.packages",)


def protected_packages():
    out = {"omarchy", "hyprland", "pacman", "linux", "systemd", "base", "sudo", "bash"}
    for f in OMARCHY_PKG_LISTS:
        try:
            out.update(l.strip() for l in open(f) if l.strip() and not l.startswith("#"))
        except OSError:
            pass
    return out


def can_uninstall(app):
    if (app.get("install") or {}).get("method") == "store":
        return True    # the store removes itself (uninstall.sh in a visible terminal)
    pkgs = (app.get("install") or {}).get("packages") or app.get("detect") or []
    return bool(pkgs) and not (set(pkgs) & protected_packages())


def run_self_uninstall(everything):
    """Remove the Omarchy Store itself (and, with everything=True, the apps that came with it) in a
    visible terminal. The script copies itself to /tmp first, so it survives deleting the store."""
    script = os.path.join(APP_DIR, "uninstall.sh")
    if not os.path.exists(script):
        # Electron/AppImage installs don't ship the script next to the helper: fetch the current one.
        script = os.path.join(STATE_DIR, "uninstall.sh")
        with urllib.request.urlopen(REMOTE + "desktop-files/uninstall.sh", timeout=30) as r:
            data = r.read(200_000)
        if not data.startswith(b"#!/bin/bash") or b"Removing the Omarchy Store" not in data:
            raise ValueError("couldn't download the uninstaller")
        os.makedirs(STATE_DIR, exist_ok=True)
        open(script, "wb").write(data)
    flag = " --all" if everything else ""
    what = "the Omarchy Store and the apps that came with it" if everything else "the Omarchy Store"
    # Tell the script where this copy of the store lives (Electron builds keep it next to the app).
    env = f"OMARCHY_STORE_HOME={shlex.quote(APP_DIR)} OMARCHY_STORE_PID={os.getpid()} "
    cmd = (f"echo {shlex.quote('Removing ' + what + '…')}; echo; {env}bash {shlex.quote(script)}{flag}; echo; "
           f"read -n1 -r -p 'Press any key to close'")
    with JOBS_LOCK:
        JOBS["omarchy-store"] = {"state": "removing", "started": time.time()}
    # The script stops this helper itself (OMARCHY_STORE_PID) once the password is confirmed, so a
    # cancelled removal leaves the store running.
    in_terminal(cmd, "Remove Omarchy Store")


def run_uninstall(app):
    """Remove a store app in Omarchy's floating terminal; the user confirms and types their own password."""
    m = (app.get("install") or {}).get("method")
    if m == "store":
        return run_self_uninstall(False)
    if m not in ("pacman", "aur", "release"):
        raise ValueError("this app can't be removed from the store")
    pkgs = (app["install"].get("packages") or []) or (app.get("detect") or [])
    if not pkgs or not all(PKG_RE.match(p) for p in pkgs):
        raise ValueError("bad package list")
    if set(pkgs) & protected_packages():
        raise ValueError("this app is part of Omarchy itself, so the store won't remove it")
    name = app["name"]
    shown = " ".join(shlex.quote(p) for p in pkgs)
    if app["id"] == "snapdock":
        # SnapDock undoes its own changes first (dock, keys, title bars) and offers to put back the
        # setup from before it; then the package, if there is one, is removed.
        script = (f"echo {shlex.quote('Removing ' + name + ' (requested from the Omarchy Store)…')}; echo; "
                  f"if command -v snapdock >/dev/null; then snapdock uninstall; fi; "
                  f"if pacman -Qq snapdock >/dev/null 2>&1; then echo; sudo pacman -Rns {shown}; fi")
    else:
        script = (f"echo {shlex.quote('Removing ' + name + ' (requested from the Omarchy Store)…')}; echo; "
                  f"echo 'Your settings and files in your home folder are kept.'; echo; "
                  f"sudo pacman -Rns {shown}")
    with JOBS_LOCK:
        JOBS[app["id"]] = {"state": "removing", "started": time.time()}
    proc = in_terminal(script, "Remove " + name)

    def watch():
        proc.wait()
        deadline = time.time() + 15 * 60
        while time.time() < deadline:
            time.sleep(3)
            if app["id"] not in installed_ids({app["id"]: app}):
                with JOBS_LOCK:
                    JOBS[app["id"]]["state"] = "removed"
                return
        with JOBS_LOCK:
            JOBS[app["id"]]["state"] = "failed"
    threading.Thread(target=watch, daemon=True).start()


def run_theme_remove(t):
    name = theme_folder(t)
    if t.get("builtin") or not os.path.isdir(os.path.join(USER_THEMES, name)):
        raise ValueError("built-in themes come with Omarchy and can't be removed")
    if name == current_theme():
        raise ValueError("switch to another theme first: this one is in use")
    subprocess.Popen(["omarchy-theme-remove", name], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def run_plugin_remove(pid):
    if not PLUGIN_ID_RE.match(pid) or pid.startswith("omarchy."):
        raise ValueError("bad plugin id")
    if pid not in installed_plugins():
        raise ValueError("plugin isn't installed")
    subprocess.Popen(["omarchy", "plugin", "remove", pid, "--yes"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def run_open(app):
    opn = app.get("open")
    if app.get("kind") == "terminal":
        if app.get("cli"):
            # Command-line tool with no full-screen UI: open a terminal and show how to use it.
            cmd = opn or app["detect"][0]
            if not CMD_RE.match(cmd):
                raise ValueError("bad command")
            msg = f"echo {shlex.quote(app['name'] + ' is installed. Try:')}; echo; echo '  {cmd} --help'; echo; exec bash"
            subprocess.Popen(["xdg-terminal-exec", "bash", "-c", msg], stdin=subprocess.DEVNULL, start_new_session=True)
            return


