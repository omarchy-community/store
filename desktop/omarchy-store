SELF = {"available": None, "installed_new": False, "last_check": 0, "last_ok": None, "last_error": None, "seen_desktop_version": None}
SELF_FILES = ["omarchy-store", "uninstall.sh", "site/index.html", "site/app.js", "site/styles.css"]


def self_update(target_version):
    """Download the newest desktop app files, sanity-check them, swap them in. The page then offers Restart."""
    staged = {}
    for f in SELF_FILES:
        with urllib.request.urlopen(REMOTE + "desktop-files/" + f, timeout=30) as r:
            staged[f] = r.read(5_000_000)
    helper = staged["omarchy-store"].decode()
    compile(helper, "omarchy-store", "exec")             # must be valid Python
    # Accept the downloaded version if it's newer than what we have (even if it's newer than target_version,
    # which can happen if a newer release was published between when the user saw the toast and clicked Update)
    m = re.search(r'^VERSION = "([^"]+)"', helper, re.M)
    if not m or not helper.startswith("#!/usr/bin/env python3"):
        raise ValueError("invalid helper file")
    dl_version = m.group(1)
    if _vercmp(dl_version, VERSION) <= 0:
        raise ValueError(f"downloaded version {dl_version} is not newer than current {VERSION}")
    assert b"<head>" in staged["site/index.html"] and b"boot()" in staged["site/app.js"]
    for f, data in staged.items():
        dest = os.path.join(APP_DIR, f)
        tmp = dest + ".new"
        open(tmp, "wb").write(data)
        if f == "omarchy-store":
            os.chmod(tmp, 0o755)
        os.replace(tmp, dest)
    SELF["installed_new"] = True


MIGRATION_STATE = {"status": "idle", "progress": 0, "error": None, "done": False}


# ----------------------------------------------------------------- server ----
class Handler(SimpleHTTPRequestHandler):
    server_version = "omarchy-store"

    def __init__(self, *a, **kw):
        super().__init__(*a, directory=SITE_DIR, **kw)

    def log_message(self, *a):
        pass

    def end_headers(self):
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Cache-Control", "no-cache")
        # No other website may show the store inside a frame (stops "clickjacking": tricking you into
        # clicking GET on a hidden copy of the store).
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy", "frame-ancestors 'none'")
        self.send_header("Referrer-Policy", "no-referrer")
        super().end_headers()

    def _json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _host_ok(self):
        # Defeat DNS rebinding: only answer to our own loopback host names.
        host = (self.headers.get("Host") or "").split(":")[0]
        return host in ("127.0.0.1", "localhost")

    def do_GET(self):
        if not self._host_ok():
            return self._json(403, {"error": "forbidden"})
        path = urllib.parse.unquote(self.path.split("?")[0])
        # Other websites can't read our answers, but they could still make the browser send GET requests
        # (e.g. via <img>) that start slow work like update checks. Browsers label those cross-site.
        if path.startswith("/api/") and self.headers.get("Sec-Fetch-Site", "same-origin") not in ("same-origin", "none"):
            return self._json(403, {"error": "forbidden"})
        # Any page path (/, /app/krita/, /category/games/, /search/x/) → the store shell.
        # Real files (have an extension) and /api/ are served normally.
        is_page = not path.startswith("/api/") and not re.search(r"\.[A-Za-z0-9]+$", path)
        if is_page or path == "/index.html":
            # Inject the session token so only this page can call the API.
            html = open(os.path.join(SITE_DIR, "index.html"), encoding="utf-8").read()
            html = html.replace("<head>", f'<head>\n<meta name="store-token" content="{TOKEN}">', 1)
            body = html.encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            return self.wfile.write(body)
        if path == "/api/status":
            cat = load_catalog()
            inst = installed_ids(cat)
            return self._json(200, {"desktop": True, "installed": inst, "theme": read_theme(),
                                    "updatable": quick_updatable(cat, inst),
                                    "removable": [i for i in inst if can_uninstall(cat[i])],
                                    "themes_installed": installed_themes(), "theme_current": current_theme(),
                                    "version": VERSION, "store_update": SELF["available"],
                                    "restart_needed": SELF["installed_new"],
                                    "update_check": {"home": APP_DIR, "home_writable": _writable(SITE_DIR),
                                                     "last_check": SELF["last_check"], "ok": SELF["last_ok"],
                                                     "error": SELF["last_error"], "seen": SELF["seen_desktop_version"]}})
        if path == "/api/usb":
            iso = latest_iso()
            with USB_LOCK:
                dl = dict(USB["dl"])
            return self._json(200, {"iso": iso, "ready": bool(iso and iso_ready(iso)), "download": dl,
                                    "drives": usb_drives(), "path": iso_path(iso) if iso else None})
        if path == "/api/updates":
            force = "refresh=1" in (self.path.split("?") + [""])[1]
            if force:
                maybe_check_self_update()
            data = check_updates(force=force)
            with JOBS_LOCK:
                running = [k[7:] for k, j in JOBS.items() if k.startswith("update:") and j["state"] == "running"]
            return self._json(200, {**data, "running": running})
        if path == "/api/plugins":
            d, raw = plugins_data()
            inst = json.dumps(installed_plugins()).encode()
            # Send the list as-is plus the user's installed plugins, without re-serialising 2 MB.
            body = raw.rstrip()[:-1] + b',"installed":' + inst + b"}" if raw.rstrip().endswith(b"}") else raw
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            return self.wfile.write(body)
        if path == "/api/plugins/installed":
            return self._json(200, {"installed": installed_plugins()})
        if path == "/api/crypto/installed":
            return self._json(200, {"installed": installed_crypto()})
        if path.startswith("/api/job/"):
            aid = path.rsplit("/", 1)[1]
            cat = load_catalog()
            with JOBS_LOCK:
                job = dict(JOBS.get(aid, {}))
            return self._json(200, {**job, "installed": aid in cat and aid in installed_ids({aid: cat[aid]})})
        if path == "/api/migrate-status":
            return self._json(200, MIGRATION_STATE)
        if path.startswith("/api/"):
            return self._json(404, {"error": "not found"})
        # Store artwork (featured banners, screenshots, Ignite) isn't shipped with the app:
        # fetch it from the live site the first time it's needed, then keep a local copy.
        m = re.match(r"^/(featured/[a-z0-9-]+/[a-z0-9._-]+\.(?:png|webp|jpg|svg)|ignite/Make-room-for-Omarchy\.zip)$", path)
        if m and not os.path.exists(os.path.join(SITE_DIR, m.group(1))):
            try:
                with urllib.request.urlopen(REMOTE + m.group(1), timeout=20) as r:
                    data = r.read(8_000_000)
                dest = os.path.join(SITE_DIR, m.group(1))
                os.makedirs(os.path.dirname(dest), exist_ok=True)
                open(dest + ".part", "wb").write(data)
                os.replace(dest + ".part", dest)
            except Exception:
                pass
        return super().do_GET()

    def do_POST(self):
        if not self._host_ok():
            return self._json(403, {"error": "forbidden"})
        origin = self.headers.get("Origin", "")
        if origin not in (f"http://127.0.0.1:{self.server.server_port}", f"http://localhost:{self.server.server_port}"):
            return self._json(403, {"error": "bad origin"})
        if not secrets.compare_digest(self.headers.get("X-Store-Token", ""), TOKEN):
            return self._json(403, {"error": "bad token"})
        try:
            n = min(int(self.headers.get("Content-Length", 0)), 4096)
            data = json.loads(self.rfile.read(n) or b"{}")
            aid = str(data.get("id", ""))
        except Exception:
            return self._json(400, {"error": "bad request"})
        if self.path == "/api/usb/download":
            iso = latest_iso()
            if not iso:
                return self._json(502, {"error": "couldn't reach omarchy.org — check your internet"})
            with USB_LOCK:
                busy = USB["dl"].get("state") in ("downloading", "verifying")
            if not busy and not iso_ready(iso):
                threading.Thread(target=download_iso, args=(iso,), daemon=True).start()
            return self._json(202, {"ok": True})
        if self.path == "/api/usb/write":
            iso = latest_iso()
            dev = str(data.get("device", ""))
            if not iso or not DEV_RE.match(dev):
                return self._json(400, {"error": "bad request"})
            try:
                write_usb(iso, dev)
                return self._json(202, {"ok": True})
            except ValueError as e:
                return self._json(400, {"error": str(e)})
        if self.path == "/api/update-all":
            run_update(None)
            return self._json(202, {"ok": True})
        if self.path == "/api/self-update":
            # The Update button: download + check the new version, swap it in, then restart on it.
            want = SELF["available"]
            if not SELF["installed_new"]:
                if not want:
                    update_catalog(quiet=True)          # maybe it was published in the last hour
                    want = SELF["available"]
                if not want:
                    return self._json(409, {"error": "You already have the newest version."})
                try:
                    self_update(want)
                except Exception as e:
                    return self._json(502, {"error": f"Couldn't download the update ({e}). Check your internet and try again."})
            self.path = "/api/restart"
        if self.path == "/api/restart":
            # Restart the helper on the freshly installed version; the page reloads itself.
            def again():
                time.sleep(0.4)
                try:
                    os.remove(PORT_FILE)
                except OSError:
                    pass
                # Come back on the same port so the open window keeps working (see free_port).
                os.environ["OMARCHY_STORE_PORT"] = str(self.server.server_port)
                httpd = self.server
                httpd.socket.close()                     # free the port before exec (fd would otherwise linger)
                os.execv(sys.executable, [sys.executable, os.path.join(APP_DIR, "omarchy-store"), "--serve"])
            threading.Thread(target=again, daemon=True).start()
            return self._json(200, {"ok": True})
        if self.path == "/api/migrate-electron":
            return self._migrate_electron()
        if self.path == "/api/migrate-status":
            return self._json(200, MIGRATION_STATE)
        if self.path == "/api/plugin/update":
            try:
                run_plugin_update(aid)
                return self._json(202, {"ok": True})
            except ValueError as ex:
                return self._json(400, {"error": str(ex)})
        if self.path == "/api/plugin/remove":
            try:
                run_plugin_remove(aid)
                return self._json(202, {"ok": True})
            except ValueError as e:
                return self._json(400, {"error": str(e)})
        if self.path == "/api/theme/remove":
            th = load_themes().get(aid)
            if not th:
                return self._json(404, {"error": "unknown theme"})
            try:
                run_theme_remove(th)
                return self._json(202, {"ok": True})
            except ValueError as e:
                return self._json(400, {"error": str(e)})
        if self.path == "/api/crypto/install":
            w = load_crypto().get(aid)
            if not w:
                return self._json(404, {"error": "unknown wallet"})
            try:
                return self._json(200, {"ok": True, "browser": run_crypto_install(w)})
            except ValueError as e:
                return self._json(400, {"error": str(e)})
            except FileNotFoundError as e:
                return self._json(500, {"error": f"missing program: {e.filename}"})
        if self.path == "/api/plugin/add":
            try:
                run_plugin_add(aid)
                return self._json(202, {"ok": True})
            except ValueError as e:
                return self._json(400, {"error": str(e)})
            except FileNotFoundError as e:
                return self._json(500, {"error": f"missing program: {e.filename}"})
        if self.path in ("/api/theme/install", "/api/theme/use"):
            th = load_themes().get(aid)
            if not th:
                return self._json(404, {"error": "unknown theme"})
            try:
                (run_theme_install if self.path.endswith("install") else run_theme_use)(th)
                return self._json(202, {"ok": True})
            except ValueError as e:
                return self._json(400, {"error": str(e)})
            except FileNotFoundError as e:
                return self._json(500, {"error": f"missing program: {e.filename}"})
        cat = load_catalog()
        app = cat.get(aid)
        if not app:
            return self._json(404, {"error": "unknown app"})
        try:
            if self.path == "/api/install":
                with JOBS_LOCK:
                    if JOBS.get(aid, {}).get("state") == "running":
                        return self._json(409, {"error": "already installing"})
                run_install(app)
                return self._json(202, {"ok": True})
            if self.path == "/api/uninstall-store":
                run_self_uninstall(bool(data.get("all")))
                return self._json(200, {"ok": True})
            if self.path == "/api/uninstall":
                with JOBS_LOCK:
                    if JOBS.get(aid, {}).get("state") in ("running", "removing"):
                        return self._json(409, {"error": "busy"})
                run_uninstall(app)
                return self._json(202, {"ok": True})
            if self.path == "/api/open":
                run_open(app)
                return self._json(200, {"ok": True})
            if self.path == "/api/update":
                run_update(app)
                return self._json(202, {"ok": True})
        except ValueError as e:
            return self._json(400, {"error": str(e)})
        except FileNotFoundError as e:
            return self._json(500, {"error": f"missing program: {e.filename}"})
        return self._json(404, {"error": "not found"})

    def _migrate_electron(self):
        """Download and install the Electron AppImage"""
        global MIGRATION_STATE
        if MIGRATION_STATE["status"] in ("downloading", "installing"):
            return self._json(409, {"error": "Migration already in progress"})

        MIGRATION_STATE["status"] = "downloading"
        MIGRATION_STATE["progress"] = 10
        MIGRATION_STATE["error"] = None
        MIGRATION_STATE["done"] = False

        def download_and_install():
            global MIGRATION_STATE
            try:
                # Step 1: Uninstall old webapp
                MIGRATION_STATE["status"] = "uninstalling"
                MIGRATION_STATE["progress"] = 5
                try:
                    uninstall_script = os.path.join(APP_DIR, "uninstall.sh")
                    if os.path.exists(uninstall_script):
                        subprocess.run([uninstall_script], check=True, capture_output=True, timeout=30)
                except Exception:
                    pass  # Ignore errors, old app might not be installed

                appimage_url = "https://omarchystore.com/desktop/Omarchy Store-1.0.0.AppImage"
                dest = os.path.expanduser("~/omarchy-store-electron.AppImage")
                tmp = dest + ".part"

                MIGRATION_STATE["status"] = "downloading"
                MIGRATION_STATE["progress"] = 20

                import urllib.request
                req = urllib.request.Request(appimage_url, headers={"User-Agent": "omarchy-store"})
                with urllib.request.urlopen(req, timeout=300) as r:
                    total = int(r.headers.get("Content-Length", 0))
                    downloaded = 0
                    with open(tmp, "wb") as f:
                        while True:
                            chunk = r.read(8192)
                            if not chunk:
                                break
                            f.write(chunk)
                            downloaded += len(chunk)
                            if total > 0:
                                MIGRATION_STATE["progress"] = 20 + int(70 * downloaded / total)

                MIGRATION_STATE["status"] = "installing"
                MIGRATION_STATE["progress"] = 95

                os.chmod(tmp, 0o755)
                os.replace(tmp, dest)

                # Create desktop entry
                desktop_entry = f"""[Desktop Entry]
Version=1.0
Type=Application
Name=Omarchy Store
Comment=The world's largest app store for Omarchy Linux
Exec={dest}
Icon=omarchy-store
Terminal=false
Categories=System;PackageManager;Utility;
StartupWMClass=Omarchy Store
StartupNotify=true
Keywords=omarchy;store;apps;themes;plugins;linux;
"""
                desktop_dir = os.path.expanduser("~/.local/share/applications")
                os.makedirs(desktop_dir, exist_ok=True)
                with open(os.path.join(desktop_dir, "omarchy-store-electron.desktop"), "w") as f:
                    f.write(desktop_entry)

                # Create launch script
                launch_script = f"""#!/bin/bash
# Omarchy Store Electron Launcher
cd ~/omarchy-store-electron
if [ -f "dist/Omarchy Store-1.0.0.AppImage" ] && command -v fusermount3 >/dev/null 2>&1; then
    exec ./dist/"Omarchy Store-1.0.0.AppImage" "$@"
else
    exec npm start "$@"
fi
"""
                launch_path = os.path.expanduser("~/.local/bin/omarchy-store-electron")
                os.makedirs(os.path.dirname(launch_path), exist_ok=True)
                with open(launch_path, "w") as f:
                    f.write(launch_script)
                os.chmod(launch_path, 0o755)

                MIGRATION_STATE["done"] = True
                MIGRATION_STATE["status"] = "complete"
                MIGRATION_STATE["progress"] = 100

            except Exception as e:
                MIGRATION_STATE["status"] = "error"
                MIGRATION_STATE["error"] = str(e)
                MIGRATION_STATE["done"] = True

        threading.Thread(target=download_and_install, daemon=True).start()
        return self._json(202, {"ok": True})

    def _migrate_status(self):
        return self._json(200, MIGRATION_STATE)


# ---------------------------------------------------------------- updates ----
def sync_artwork(want):
    """Keep the saved store artwork identical to the website's: any copy whose fingerprint differs from the
    catalog's (or that was never fetched) is downloaded again. Files the catalog doesn't list are left alone."""
    import hashlib
    for rel, h in want.items():
        if not re.match(r"^featured/[a-z0-9-]+/[a-z0-9._-]+\.(png|webp|jpg|svg)$", rel) or not re.match(r"^[0-9a-f]{16}$", str(h)):
            continue
        dest = os.path.join(SITE_DIR, rel)
        try:
            if os.path.exists(dest) and hashlib.sha256(open(dest, "rb").read()).hexdigest()[:16] == h:
                continue
            if not os.path.exists(dest) and not os.path.exists(os.path.dirname(dest)):
                continue   # never fetched before: it downloads the first time a page needs it
            with urllib.request.urlopen(REMOTE + rel, timeout=20) as r:
                blob = r.read(8_000_000)
            if hashlib.sha256(blob).hexdigest()[:16] != h:
                continue   # the website is mid-deploy; try again next refresh
            open(dest + ".part", "wb").write(blob)
            os.replace(dest + ".part", dest)
        except Exception:
            pass


def update_catalog(quiet=False):
    """Pull the newest catalog + icons from GitHub Pages. Never touches code files."""
    try:
        with urllib.request.urlopen(REMOTE + "catalog.json", timeout=20) as r:
            data = r.read()
        cat = json.loads(data)
        assert isinstance(cat.get("apps"), list) and cat["apps"]
        # Check for a newer desktop app FIRST — before recipe validation and before touching the disk.
        # A catalog entry this version doesn't understand, or a failed icon/catalog write (read-only
        # install, full disk…), must never be able to hide the update that fixes it.
        want = str(cat.get("desktop_version") or "")
        SELF["last_check"] = time.time()
        SELF["seen_desktop_version"] = want
        if want and _vercmp(want, VERSION) > 0 and not SELF["installed_new"]:
            SELF["available"] = want
        # Validate every recipe *before* accepting the new catalog.
        for a in cat["apps"]:
            if (a.get("install") or {}).get("method") != "store":   # the store's own listing has no recipe
                recipe(a)
            if not re.match(r"^[a-z0-9-]+$", a["id"]):
                raise ValueError("bad id " + a["id"])
        # Sync essential assets (logo, wordmarks) so the brand always displays correctly
        assets_dir = os.path.join(SITE_DIR, "assets")
        os.makedirs(assets_dir, exist_ok=True)
        for asset in ["logo.svg", "wordmark-omarchy.svg", "wordmark-store.svg"]:
            dest = os.path.join(assets_dir, asset)
            if not os.path.exists(dest) or os.path.getsize(dest) < 100:
                try:
                    with urllib.request.urlopen(REMOTE + "assets/" + asset, timeout=20) as r:
                        open(dest, "wb").write(r.read(500_000))
                except Exception:
                    pass
        icons = os.path.join(SITE_DIR, "icons")
        os.makedirs(icons, exist_ok=True)
        for a in cat["apps"]:
            ic = a.get("icon") or ""
            # Handle both icons/name.png and featured/app-name/icon.png
            m = re.match(r"^icons/([a-z0-9-]+\.(png|svg|jpg|webp))$", ic)
            m2 = re.match(r"^featured/([a-z0-9-]+)/icon\.(png|svg|jpg|webp)$", ic)
            if m and not os.path.exists(os.path.join(SITE_DIR, ic)):
                try:
                    with urllib.request.urlopen(REMOTE + ic, timeout=20) as r:
                        open(os.path.join(icons, m.group(1)), "wb").write(r.read(2_000_000))
                except Exception:
                    pass
            elif m2 and not os.path.exists(os.path.join(SITE_DIR, ic)):
                try:
                    feat_dir = os.path.join(SITE_DIR, "featured", m2.group(1))
                    os.makedirs(feat_dir, exist_ok=True)
                    with urllib.request.urlopen(REMOTE + ic, timeout=20) as r:
                        open(os.path.join(feat_dir, f"icon.{m2.group(2)}"), "wb").write(r.read(2_000_000))
                except Exception:
                    pass
        sync_artwork(cat.get("artwork") or {})
        tmp = os.path.join(SITE_DIR, ".catalog.json.tmp")
        open(tmp, "wb").write(data)
        os.replace(tmp, os.path.join(SITE_DIR, "catalog.json"))
        # Newer desktop app published? (Detected above.) The page shows an Update button (bottom right);
        # nothing is swapped until the user clicks it. `omarchy-store --update` (terminal) installs it straight away.
        SELF["last_ok"] = True
        SELF["last_error"] = None
        if SELF["available"] and not SELF["installed_new"]:
            if not quiet:
                try:
                    self_update(SELF["available"])
                    print(f"✓ desktop app updated to {SELF['available']} (restart the store to use it)")
                except Exception as e:
                    print(f"✗ desktop app update failed: {e}")
        if not quiet:
            print(f"✓ catalog updated: {len(cat['apps'])} apps")
        return True
    except Exception as e:
        SELF["last_check"] = time.time()
        SELF["last_ok"] = False
        SELF["last_error"] = f"{type(e).__name__}: {e}"
        if not quiet:
            print(f"✗ update failed: {e}")
        return False


def updater():
    while True:
        update_catalog(quiet=True)
        time.sleep(UPDATE_EVERY)


# ---------------------------------------------------------------- startup ----
def alive(port):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/status", timeout=2) as r:
            return json.load(r).get("desktop") is True
    except Exception:
        return False


def free_port():
    # After a self-update restart we MUST come back on the same port: the Electron window (and the page
    # that is reloading itself) only know the old one. The old port is in TIME_WAIT from the page's own
    # requests, so the probe needs SO_REUSEADDR (the server sets it too) or it would wrongly skip ahead.
    keep = os.environ.get("OMARCHY_STORE_PORT")
    order = ([int(keep)] if keep and keep.isdigit() else []) + list(range(DEFAULT_PORT, DEFAULT_PORT + 20))
    for p in order:
        with socket.socket() as s:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                s.bind(("127.0.0.1", p))
                return p
            except OSError:
                continue
    raise SystemExit("no free port")


def serve():
    os.makedirs(STATE_DIR, exist_ok=True)
    port = free_port()
    httpd = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    open(PORT_FILE, "w").write(str(port))
    threading.Thread(target=updater, daemon=True).start()
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))
    try:
        httpd.serve_forever()
    finally:
        try:
            os.remove(PORT_FILE)
        except OSError:
            pass


def open_window(port):
    url = f"http://127.0.0.1:{port}/"
    # Pass extra Chromium flags to hide the URL status bubble and set window class
    extra_args = ["--class=omarchy-store", "--disable-features=StatusBubble"]
    for cmd in (["omarchy-launch-webapp", url] + extra_args, ["xdg-open", url]):
        if shutil.which(cmd[0]):
            subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            return
    print("Open", url)


def main():
    args = sys.argv[1:]
    prepare_home()
    if "--serve" in args:
        return serve()
    if "--update" in args:
        sys.exit(0 if update_catalog() else 1)
    if "--uninstall" in args:
        extra = ["--all"] if "--all" in args else []
        return subprocess.call(["bash", os.path.join(APP_DIR, "uninstall.sh")] + extra)
    port = None
    try:
        port = int(open(PORT_FILE).read())
    except Exception:
        pass
    if not (port and alive(port)):
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "--serve"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        for _ in range(50):
            time.sleep(0.1)
            try:
                port = int(open(PORT_FILE).read())
                if alive(port):
                    break
            except Exception:
                pass
        else:
            raise SystemExit("omarchy-store: helper failed to start (try: omarchy-store --serve)")
    open_window(port)


if __name__ == "__main__":
    main()